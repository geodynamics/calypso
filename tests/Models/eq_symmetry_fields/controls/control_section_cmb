!
!
!     example of control for Kemo's surface rendering
!
begin cross_section_ctl
  section_file_prefix    'sections/cmb'
  section_file_format    binary_gz
!
  file  surface_define  'controls/control_surface_CMB'
!
  begin output_field_define
    array output_field
      output_field  temperature               scalar
      output_field  magnetic_field            spherical_vector
      output_field  truncated_magnetic_field  spherical_vector
      output_field  sym_magnetic_field        spherical_vector
      output_field  asym_magnetic_field       spherical_vector
    end array output_field
  end output_field_define
end cross_section_ctl
