#
# Makefile header for Calypso Dynamo tests
#
#
SHELL = /bin/sh
#
#  all:         compile programs for simulations
#
# Compiler commands
#
CC=gcc
F90=mpif90
AR=ar
RANLIB=ranlib
#
# Compiler options
#
SHAREDLIB_FLAG = --enable-shared
F90OPTFLAGS =     -fPIC -O3 -Wall -g -fopenmp  $(F_INCLUDE)
F90CPPFLAGS =     -DZLIB_IO -DFFTW3 -DHDF5_IO
OPTFLAGS =        -fPIC -O3 -Wall -g  -D__APPLE__
#
# Libralies and includes settting
#

F90LIBS =   $(ZLIB_LIBS) $(FFTW3_LIBS) $(HDF5_LDFLAGS) $(HDF5_FLIBS)
F_INCLUDE = -I. -I$(MAKEDIR) $(HDF5_FFLAGS)
C_INCLUDE = -I. -I$(MAKEDIR) $(ZLIB_CFLAGS)  $(FFTW3_CFLAGS)

#
# zlib settings
#
ZLIB_CFLAGS = 
ZLIB_LIBS =   -lz
#
# BLAS settings
#
BLAS_LIBS =   
#
# FFTW3 settings
#
FFTW3_CFLAGS =   -I/opt/homebrew/Cellar/fftw/3.3.10_2/include
FFTW3_LIBS =     -L/opt/homebrew/Cellar/fftw/3.3.10_2/lib -lfftw3
FFTW3_OMP_LIBS = 
#
# HDF5 settings
#
HDF5_FFLAGS = -I/opt/homebrew/lib -L/opt/homebrew/lib -I/opt/homebrew/include 
HDF5_LDFLAGS = -L/opt/homebrew/lib 
HDF5_FLIBS = -L/opt/homebrew/lib -lhdf5_fortran -lhdf5
#
# -----------------------------------------------------------
# -----------------------------------------------------------
#
# Directory lists
#
SRCDIR = /Users/matsui/CALYPSO_test
#
MAKEDIR = /Users/matsui/CALYPSO_test/work
BUILDDIR = /Users/matsui/CALYPSO_test/bin
MHDDIR = /Users/matsui/CALYPSO_test/src
INSTDIR = /Users/matsui/local
EXPDIR = /Users/matsui/CALYPSO_test/examples
TESTDIR = /Users/matsui/CALYPSO_test/tests
#
#
# -----------------------------------------------------------
# library lists
# -----------------------------------------------------------
LIB_CALYPSO =      -lcalypso
LIB_CALYPSO_FILE = libcalypso.a
#
LIB_MESH =      -lcalypso_core
LIB_MESH_FILE = libcalypso_core.a

LIB_SOLVER =      -lcalypso_solver
LIB_SOLVER_FILE = libcalypso_solver.a

LIB_PARA =      -lcalypso_parallel
LIB_PARA_FILE = libcalypso_parallel.a
#
LIB_MHD = -lcalypso_MHD
LIB_MHD_FILE = libcalypso_MHD.a
#
LIB_UTILS =       -lcalypso_utils
LIB_UTILS_FILE =  libcalypso_utils.a
#
LIB_VIZ =      -lkemo_viz
LIB_VIZ_FILE = libkemo_viz.a

LIB_CALYPSO_C =      -lcalypso_c
LIB_CALYPSO_C_FILE = libcalypso_c.a

LIB_FFTPACK =      -lfftpack.5d
LIB_FFTPACK_FILE = libfftpack.5d.a

LIBS_SPH_MHD= \
$(LIB_CALYPSO) $(LIB_CALYPSO_C) $(LIB_FFTPACK) $(LIB_NETLIB)
LIB_FILES_SPH_MHD= \
$(LIB_CALYPSO_FILE) $(LIB_CALYPSO_C_FILE) $(LIB_FFTPACK_FILE) $(LIB_NETLIB_FILE)
#
LIBS_MESH_UTILS= \
$(LIB_CALYPSO) $(LIB_CALYPSO_C)
LIB_FILES_MESH_UTILS= \
$(LIB_CALYPSO_FILE) $(LIB_CALYPSO_C_FILE)
#
LIBS_FFT_TEST= \
$(LIB_MESH) $(LIB_FFTPACK) $(LIB_NETLIB)
LIB_FILES_FFT_TEST= \
$(LIB_MESH_FILE) $(LIB_FFTPACK_FILE) $(LIB_NETLIB_FILE)
#
LIB_PYTHONS= \
-L$(PYTHONDIR) -lcalypso_to_pythons
LIB_FILE_PYTHONS= \
$(PYTHONDIR)/libcalypso_to_pythons.dylib
#
LIB_PYTHON_UTILS= \
$(LIB_MESH) $(LIB_KEMO_C)
LIB_FILES_PYTHON_UTILS= \
$(LIB_MESH_FILE) $(LIB_KEMO_C_FILE)
#
